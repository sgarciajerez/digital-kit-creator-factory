  "formula_rules": [
    {
      "sheet": "Resumen",
      "cell": "E12",
      "contains": "C12-D12",
      "description": "Pendiente = plan menos pagado."
    },
    {
      "sheet": "Pagos reales",
      "cell": "C8",
      "contains": "SUMIFS",
      "description": "Los pagos reales proceden del diario de proveedores."
    },
    {
      "sheet": "Flujo de pagos",
      "cell": "H8",
      "contains": "C8-F8+D8-G8",
      "description": "Saldo previsto combina presupuesto, ingresos, pagos y ajustes."
    },
    {
      "sheet": "Checklist",
      "cell": "J10",
      "contains": "IF(F10=\"Confirmado\",1,0)",
      "description": "Progreso refleja el estado de la tarea."
    },
    {
      "sheet": "Invitados",
      "cell": "C11",
      "contains": "SUM(C8:C10)",
      "description": "El total de invitados previstos suma grupos, no porcentajes."
    }
  ],
  "relationships": [
    "Proveedores es el diario operativo; Pagos reales y Flujo de pagos se alimentan de él.",
    "Invitados previstos, Confirmados y Mesa son conteos enteros.",
    "Los porcentajes solo describen progreso o pagado, nunca número de invitados.",
    "Las filas TOTAL están fuera de las tablas de datos."
  ],
  "cases": [
    {
      "name": "guest total follows group counts",
      "purpose": "Comprueba que el total de invitados suma personas y no interpreta la columna como porcentaje.",
      "inputs": [
        {
          "sheet": "Invitados",
          "cell": "C8",
          "value": 40
        }
      ],
      "assertions": [
        {
          "sheet": "Invitados",
          "cell": "C11",
          "operator": "equals",
          "value": 130
        }
      ]
    }
  ],
  "failure_criteria": [
    "Invitados previstos, Confirmados o Mesa usan formato porcentaje.",
    "Los pagos reales se introducen duplicados en vez de salir de Proveedores.",
    "Pendiente o saldo previsto deja de ser una relación calculada.",
    "Una fila TOTAL queda dentro del rango filtrable de la tabla."
  ]
}
