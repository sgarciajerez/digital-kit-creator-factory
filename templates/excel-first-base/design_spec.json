      },
      {
        "sheet": "Resumen",
        "cell": "F12",
        "contains": "D12/C12",
        "description": "El porcentaje compara gasto real con presupuesto."
      },
      {
        "sheet": "Gastos reales",
        "cell": "C8",
        "contains": "SUMIFS",
        "description": "El gasto real nace de Movimientos y no se duplica manualmente."
      },
      {
        "sheet": "Flujo de caja",
        "cell": "I8",
        "contains": "D8-F8-H8",
        "description": "Disponible = ingreso real - gasto real - ahorro real."
      },
      {
        "sheet": "Metas y fondo",
        "cell": "G10",
        "contains": "MAX(E10-F10,0)",
        "description": "Pendiente nunca puede ser negativa."
      },
      {
        "sheet": "Metas y fondo",
        "cell": "H10",
        "contains": "F10/E10",
        "description": "Progreso = ahorrado / meta necesaria."
      }
