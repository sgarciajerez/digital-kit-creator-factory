  "formula_rules": [
    {
      "sheet": "Resumen",
      "cell": "E12",
      "contains": "C12-D12",
      "description": "La diferencia es presupuesto menos gasto real."
    },
    {
      "sheet": "Resumen",
      "cell": "F12",
      "contains": "D12/C12",
      "description": "El porcentaje compara gasto real con presupuesto."
    },
    {
      "sheet": "Gastos reales",
      "cell": "C8",
      "contains": "SUMIFS",
      "description": "El gasto real nace de Movimientos y no se duplica manualmente."
    },
    {
      "sheet": "Flujo de caja",
      "cell": "I8",
      "contains": "D8-F8-H8",
      "description": "Disponible = ingreso real - gasto real - ahorro real."
    },
    {
      "sheet": "Metas y fondo",
      "cell": "G10",
      "contains": "MAX(E10-F10,0)",
      "description": "Pendiente nunca puede ser negativa."
    },
    {
      "sheet": "Metas y fondo",
      "cell": "H10",
      "contains": "F10/E10",
      "description": "Progreso = ahorrado / meta necesaria."
    },
    {
      "sheet": "Presupuesto",
      "cell": "B8",
      "contains": "Listas!I7",
      "description": "La categoría presupuestaria se obtiene de la lista editable de Listas."
    }
  ],
  "relationships": [
    "Movimientos es la única entrada operativa para gastos reales y flujo de caja.",
    "Presupuesto y Gastos reales comparten categorías y meses.",
    "Las filas TOTAL quedan fuera del rango de datos de cada tabla.",
    "Las columnas de conteo nunca se expresan como porcentaje."
  ],
  "cases": [
    {
      "name": "income flows into monthly cash flow",
      "purpose": "Comprueba que el ingreso neto declarado alimenta la lectura mensual.",
      "inputs": [
        {
          "sheet": "Listas",
          "cell": "C9",
          "value": 3500
        }
      ],
      "assertions": [
        {
          "sheet": "Flujo de caja",
          "cell": "C8",
          "operator": "equals",
          "value": 3500
        }
      ]
    }
  ],
  "failure_criteria": [
    "Una tabla tiene una cabecera vacía, genérica, duplicada o con un significado distinto.",
    "Una fila TOTAL queda dentro del rango filtrable de datos.",
    "Gastos reales deja de depender de Movimientos o Disponible deja de seguir su ecuación.",
    "Una columna de conteo usa formato porcentaje o una columna monetaria usa porcentaje."
  ]
